<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    android:background="@color/white"
    app:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/white">

        <!-- Threat Snapshot -->
        <ImageView
            android:id="@+id/imgThreat"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/place_holder"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="@string/threat_snapshot" />

        <!-- Threat Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <!-- Camera Name -->
            <TextView
                android:id="@+id/tvThreatCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detected by Main Cam"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Date & Time -->
            <TextView
                android:id="@+id/tvThreatDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Sep 2025 • 02:30 AM"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- More Options -->
        <ImageView
            android:id="@+id/ivMoreThreat"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/more_options" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
